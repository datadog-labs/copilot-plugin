# Datadog observability runbook - environment template
#
# Copy to runbook/.env (git-ignored) and fill in. Three ways to fill it:
#   1. By hand, using the "discover:" hint on each line.
#   2. Automatically:  node tools/fill-env.mjs            (discovers values with az, gh and the Datadog API)
#   3. With Copilot:   ask "/ddrunbook fill my .env"      (skills/ddrunbook walks the same discovery steps)
# tools/fill-env.mjs only fills empty keys unless --force; it never prints secret values.
# Regenerate this template after adding modules:  node tools/docs.mjs --env-example

# --- Datadog -------------------------------------------------------------------------------------
DD_SITE=datadoghq.com
DD_APP_URL=https://app.datadoghq.com
# Secrets: only needed for tools/apply.mjs, export.mjs, fill-env.mjs and the bridges. Never commit.
DD_API_KEY=
DD_APP_KEY=
# discover: GET /api/v1/org -> name
DD_ORG_NAME=
DD_NAME_PREFIX="Contoso | "
DD_PROJECT_TAG=project:contoso

# --- Notifications ---------------------------------------------------------------------------------
# Handle(s) appended to every monitor message, e.g. @teams-Datadog_Alerts
DD_RUNBOOK_NOTIFY="No notification recipients configured; Teams destination selection is pending."
# discover: Integrations > Microsoft Teams > Tenant-based handles
DD_TEAMS_HANDLE=

# --- Hosts -----------------------------------------------------------------------------------------
# discover: GET /api/v1/hosts
DD_AGENT_HOST=
DD_DC_HOST_FILTER=role:domain-controller

# --- Azure / Entra ID ------------------------------------------------------------------------------
# discover: az account show --query "{tenant:tenantId, sub:id}"
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-datadog-observability
AZURE_LOCATION=eastus2
AZURE_EVENTHUB_NAMESPACE=evhns-datadog-logs
AZURE_EVENTHUB_NAME=datadog-logs
# discover: az resource list --resource-type microsoft.insights/components --subscription $AZURE_SUBSCRIPTION_ID
APPINSIGHTS_NAME=
APPINSIGHTS_APP_ID=
LOG_ANALYTICS_WORKSPACE_ID=

# --- Microsoft 365 audit ---------------------------------------------------------------------------
M365_AUDIT_SERVICE_ENTRA=AzureActiveDirectory
M365_AUDIT_SERVICE_TEAMS=MicrosoftTeams

# --- GitHub ----------------------------------------------------------------------------------------
# discover: gh api user/orgs --jq '.[].login'   (comma-separated)
GITHUB_ORGS=
GITHUB_USER_ACCOUNTS=
# discover: gh api orgs/<org>/audit-log --jq '.[0].business'
GITHUB_ENTERPRISE_SLUG=
# discover: org_name tag values on github_copilot.* metrics (lowercase)
GITHUB_COPILOT_ORGS=

# --- Power Platform --------------------------------------------------------------------------------
# discover: pac env list   (comma-separated, same order)
PP_ENVIRONMENT_IDS=
PP_ENVIRONMENT_URLS=

# --- Datadog object IDs (filled by tools/apply.mjs, tools/export.mjs or tools/fill-env.mjs) ------------
# One DD_ID_<RESOURCE_ID> per dashboard/monitor; generated section below.
